# --- Dashboard access protection (recommended once deployed publicly) ---
# Set any secret string. Leave blank/unset to disable protection (local dev).
DASHBOARD_ACCESS_KEY=choose-a-secret-here

# --- FREE PATH (recommended for local dev, no billing required) ---
# Get a free key at https://aistudio.google.com -> Get API key
GOOGLE_API_KEY=your-ai-studio-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# --- PAID PATH (Vertex AI, alternative to the above) ---
# Leave GOOGLE_API_KEY unset if you use this instead
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_GENAI_USE_VERTEXAI=true

# --- ClickHouse: local Docker (free, default below) ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=continuity_guardian
CLICKHOUSE_SECURE=false

# --- ClickHouse Cloud (alternative to the above) ---
# CLICKHOUSE_HOST=your-instance.clickhouse.cloud
# CLICKHOUSE_PORT=8443
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=change-me
# CLICKHOUSE_SECURE=true
